# Managed by PanelPro for {{ domain }} — edit via the panel.
{% if force_https and ssl_cert %}
<VirtualHost *:80>
    ServerName {{ domain }}
{% for a in aliases %}    ServerAlias {{ a }}
{% endfor %}    Redirect permanent / https://{{ domain }}/
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ domain }}
{% for a in aliases %}    ServerAlias {{ a }}
{% endfor %}
    SSLEngine on
    SSLCertificateFile    {{ ssl_cert }}
    SSLCertificateKeyFile {{ ssl_key }}
{% else %}
<VirtualHost *:80>
    ServerName {{ domain }}
{% for a in aliases %}    ServerAlias {{ a }}
{% endfor %}
{% endif %}
    DocumentRoot {{ root }}

    <Directory {{ root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog  {{ error_log }}
    CustomLog {{ access_log }} combined

{% if proxy_target %}
    ProxyPreserveHost On
    ProxyPass        / {{ proxy_target }}/
    ProxyPassReverse / {{ proxy_target }}/
{% elif php_version %}
    <FilesMatch \.php$>
        SetHandler "proxy:unix:{{ php_socket }}|fcgi://localhost"
    </FilesMatch>
{% endif %}

    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</VirtualHost>
