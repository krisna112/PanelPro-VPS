# Managed by PanelPro setup-domain
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_root | config_path }};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
{% if certificate %}
        return 301 https://{{ domain }}$request_uri;
{% else %}
        return 404;
{% endif %}
    }
}
{% if certificate %}

map $http_upgrade $panelpro_login_connection {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ domain }};
    ssl_certificate {{ certificate.cert_path | config_path }};
    ssl_certificate_key {{ certificate.key_path | config_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2g;

    location / {
        proxy_pass {{ backend }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $panelpro_login_connection;
        proxy_read_timeout 300s;
    }
}
{% endif %}
